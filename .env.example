# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# App
APP_NAME="TaskGate"
ENVIRONMENT=local
DEBUG=true

# Database
POSTGRES_USER=<pick-a-username>
POSTGRES_PASSWORD=<pick-a-strong-password>
POSTGRES_DB=taskgate
DATABASE_URL=postgresql+asyncpg://<same-user>:<same-password>@db:5432/taskgate

# Redis / ARQ
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=<generate-a-long-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Webhooks
WEBHOOK_MAX_ATTEMPTS=3

# Project lifecycle
PROJECT_AUTO_ARCHIVE_DAYS=30
TASK_READY_AUTO_DONE_DAYS=7
DEVELOPER_WIP_LIMIT=2
